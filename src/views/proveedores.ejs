<%- include('layout/base.ejs', { titulo: titulo, script: 'cargarProveedores();', body: `
  <h1 class="page-title">🚚 Proveedores</h1>
  <div class="toolbar">
      <button class="btn" onclick="nuevoProveedor()">+ Agregar Proveedor</button>
  </div>
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Teléfono</th>
          <th>Email</th>
          <th>Direccion</th>
          <th>Ciudad</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="tablaProveedores">
        <tr><td colspan="7" class="text-center">Cargando...</td></tr>
      </tbody>
    </table>
  </div>
  <div id="modalProveedor" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h2 id="modalTituloProveedor">Nuevo Proveedor</h2>
        <button class="modal-close" onclick="cerrarModal('modalProveedor')">X</button>
      </div>
      <div class="modal-form">
        <input type="hidden" id="proveedorId" />
        <div class="form-group">
          <label>Nombre</label>
          <input class="input" id="provNombre" placeholder="Nombre del proveedor" />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Teléfono</label>
            <input class="input" id="provTelefono" placeholder="Teléfono" />
          </div>
          <div class="form-group">
            <label>Ciudad</label>
            <input class="input" id="provCiudad" placeholder="Ciudad" />
          </div>
        </div>
        <div class="form-group">
          <label>Dirección</label>
          <input class="input" id="provDireccion" placeholder="Dirección" />
        </div>
        <div class="form-group">
          <label>Email</label>
          <input class="input" id="provEmail" type="email" placeholder="correo@ejemplo.com" />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalProveedor')">Cancelar</button>
          <button type="button" class="btn" onclick="guardarProveedor()">Guardar</button>
        </div>
      </div>
    </div>
  </div>
` }) %>
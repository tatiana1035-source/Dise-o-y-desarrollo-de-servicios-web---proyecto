<%- include('layout/base.ejs', { titulo: titulo, script: 'cargarCodigos();', body: `
  <h1 class="page-title">🔖 Códigos</h1>
  <div class="toolbar">
    <button class="btn" onclick="nuevoCodigo()">+ Generar Código</button>
  </div>
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Código</th>
          <th>Producto</th>
          <th>Tipo</th>
          <th>Fecha</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="tablaCodigos">
        <tr><td colspan="6" class="text-center">Cargando...</td></tr>
      </tbody>
    </table>
  </div>

  <div id="modalCodigo" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h2 id="modalTituloCodigo">Generar Código</h2>
        <button class="modal-close" onclick="cerrarModal('modalCodigo')">X</button>
      </div>
      <div class="modal-form">
        <input type="hidden" id="codigoId" />
        <div class="form-group">
          <label>ID Producto</label>
          <input class="input" id="codProducto" type="number" placeholder="ID del producto" />
        </div>
        <div class="form-group">
          <label>Tipo</label>
          <select class="input" id="codTipo">
            <option value="barcode">Código de Barras</option>
            <option value="qr">Código QR</option>
          </select>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalCodigo')">Cancelar</button>
          <button type="button" class="btn" onclick="guardarCodigo()">Generar</button>
        </div>
      </div>
    </div>
  </div>
` }) %>
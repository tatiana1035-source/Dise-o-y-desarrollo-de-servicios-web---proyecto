<%- include('layout/base.ejs', { titulo: titulo, script: 'cargarCategorias();', body: `
  <h1 class="page-title">🏷️ Categorías</h1>
  <div class="toolbar">
    <button class="btn" onclick="nuevaCategoria()">+ Nueva Categoría</button>
  </div>
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="tablaCategorias">
        <tr><td colspan="4" class="text-center">Cargando...</td></tr>
      </tbody>
    </table>
  </div>

  <div id="modalCategoria" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h2 id="modalTituloCategoria">Nueva Categoría</h2>
        <button class="modal-close" onclick="cerrarModal('modalCategoria')">X</button>
      </div>
      <div class="modal-form">
        <input type="hidden" id="categoriaId" />
        <div class="form-group">
          <label>Nombre</label>
          <input class="input" id="cNombre" placeholder="Nombre de la categoría" />
        </div>
        <div class="form-group">
          <label>Descripción</label>
          <textarea class="input" id="cDescripcion" rows="2" placeholder="Descripción opcional"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalCategoria')">Cancelar</button>
          <button type="button" class="btn" onclick="guardarCategoria()">Guardar</button>
        </div>
      </div>
    </div>
  </div>
` }) %>